{
  "openapi": "3.1.0",
  "info": {
    "title": "17TRACK Order Tracking",
    "description": "Cross-border e-commerce order tracking for 3500+ carriers with automatic status updates",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://your-gateway.example.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "seventeenToken": {
        "type": "apiKey",
        "in": "header",
        "name": "17token"
      }
    }
  },
  "security": [
    {
      "seventeenToken": []
    }
  ],
  "paths": {
    "/getquota": {
      "post": {
        "operationId": "get_quota",
        "summary": "Get the current tracking and email quota counters for the 17TRACK account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {},
                "maxItems": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quota counters"
          }
        }
      }
    },
    "/register": {
      "post": {
        "operationId": "register_trackings",
        "summary": "Register up to 40 tracking numbers for automatic tracking by 17TRACK",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "number"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "auto_detection": {
                      "type": "boolean"
                    },
                    "lang": {
                      "type": "string"
                    },
                    "tag": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "remark": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    },
    "/gettrackinfo": {
      "post": {
        "operationId": "get_tracking_details",
        "summary": "Get current tracking details for up to 40 registered tracking numbers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "number"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "carrier": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    },
    "/gettracklist": {
      "post": {
        "operationId": "list_trackings",
        "summary": "List registered 17TRACK shipments with status and pagination filters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "page_no": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "package_status": {
                    "type": "string",
                    "enum": [
                      "NotFound",
                      "InfoReceived",
                      "InTransit",
                      "Expired",
                      "AvailableForPickup",
                      "OutForDelivery",
                      "DeliveryFailure",
                      "Delivered",
                      "Exception"
                    ]
                  },
                  "tracking_status": {
                    "type": "string",
                    "enum": [
                      "Tracking",
                      "Stopped"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tracking list with pagination"
          }
        }
      }
    },
    "/stoptrack": {
      "post": {
        "operationId": "stop_tracking",
        "summary": "Stop automatic tracking for up to 40 registered tracking numbers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "number"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "carrier": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    },
    "/retrack": {
      "post": {
        "operationId": "restart_tracking",
        "summary": "Restart automatic tracking for up to 40 stopped tracking numbers; each number can only be restarted once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "number"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "carrier": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    },
    "/deletetrack": {
      "post": {
        "operationId": "delete_trackings",
        "summary": "Permanently delete up to 40 registered tracking numbers; deleted shipments cannot be restored",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "number"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "carrier": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    },
    "/push": {
      "post": {
        "operationId": "push_trackings",
        "summary": "Queue a webhook push of the latest tracking results for up to 40 registered tracking numbers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "number"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "carrier": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    },
    "/changecarrier": {
      "post": {
        "operationId": "change_carrier",
        "summary": "Change the carrier of up to 40 registered tracking numbers; each number can be changed up to 5 times",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "number",
                    "carrier_new"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "carrier_old": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "carrier_new": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    },
    "/changeinfo": {
      "post": {
        "operationId": "update_tracking_info",
        "summary": "Update the metadata (tag, addresses, language, remark, order info) of up to 40 registered tracking numbers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "required": [
                    "number",
                    "items"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "items": {
                      "type": "object",
                      "minProperties": 1,
                      "properties": {
                        "tag": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "lang": {
                          "type": "string"
                        },
                        "remark": {
                          "type": "string",
                          "maxLength": 1000
                        },
                        "order_no": {
                          "type": "string"
                        },
                        "order_time": {
                          "type": "string"
                        },
                        "ship_date": {
                          "type": "string"
                        },
                        "origin_country": {
                          "type": "string"
                        },
                        "destination_country": {
                          "type": "string"
                        },
                        "destination_city": {
                          "type": "string"
                        },
                        "destination_postal_code": {
                          "type": "string"
                        },
                        "shipper": {
                          "type": "string"
                        },
                        "consignee": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    },
    "/getRealTimeTrackInfo": {
      "post": {
        "operationId": "get_realtime_tracking_details",
        "summary": "Query a single tracking number against carriers in real time; Standard mode (cacheLevel 0) costs 1 quota, Instant mode (cacheLevel 1) costs 10 quota",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "number"
                  ],
                  "properties": {
                    "number": {
                      "type": "string",
                      "minLength": 5,
                      "maxLength": 50,
                      "pattern": "^[A-Za-z0-9-]+$"
                    },
                    "carrier": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "cacheLevel": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result with accepted and rejected items"
          }
        }
      }
    }
  }
}
